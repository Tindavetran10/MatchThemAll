{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Claude: Switch Model...",
      "type": "shell",
      "command": "& '${workspaceFolder}\\switch-model.ps1' ${input:modelSelection}",
      "options": {
        "shell": {
          "executable": "pwsh.exe",
          "args": ["-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Claude: Switch to GLM 5.2 (z.ai)",
      "type": "shell",
      "command": "& '${workspaceFolder}\\switch-model.ps1' glm",
      "options": {
        "shell": {
          "executable": "pwsh.exe",
          "args": ["-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Claude: Switch to Kimi K2 (Moonshot AI)",
      "type": "shell",
      "command": "& '${workspaceFolder}\\switch-model.ps1' kimi",
      "options": {
        "shell": {
          "executable": "pwsh.exe",
          "args": ["-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Claude: Switch to OpenRouter (free)",
      "type": "shell",
      "command": "& '${workspaceFolder}\\switch-model.ps1' openrouter",
      "options": {
        "shell": {
          "executable": "pwsh.exe",
          "args": ["-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Claude: Show Active Model",
      "type": "shell",
      "command": "& '${workspaceFolder}\\switch-model.ps1'",
      "options": {
        "shell": {
          "executable": "pwsh.exe",
          "args": ["-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": "none",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "modelSelection",
      "type": "pickString",
      "description": "Select the AI model profile to switch to:",
      "options": [
        {
          "label": "GLM 5.2 (z.ai)",
          "value": "glm"
        },
        {
          "label": "Kimi K2 (Moonshot AI)",
          "value": "kimi"
        },
        {
          "label": "OpenRouter (free)",
          "value": "openrouter"
        }
      ],
      "default": "glm"
    }
  ]
}
